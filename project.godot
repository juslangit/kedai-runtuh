; Kedai Runtuh — Godot project settings
; Engine configuration file. Edited by hand + by the Godot editor.

config_version=5

[application]

config/name="Kedai Runtuh"
config/description="Stack the mamak order as high as you can before it collapses."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[physics]

3d/default_gravity=11.0

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
